# Reglas de reescritura para Cloudflare Pages.
#
# OJO: hoy NO parece que Cloudflare las este aplicando en este proyecto. Se probo con el comodin
# global (/*) y con una regla por modulo, y en los dos casos /pacientes/3451 devolvia 404. Quien
# resuelve hoy los enlaces directos es 404.html, que el build genera como copia de la aplicacion
# (ver scripts/generar-404.mjs). Este archivo se conserva porque, si en algun momento las reglas
# si se aplican, el enlace directo responde 200 en vez de 404, que es mas correcto.
#
# La linea de prueba de abajo sirve para salir de dudas sin adivinar: si despues de desplegar
#   curl -o /dev/null -w "%{http_code}" https://therateam.pages.dev/zzz-prueba-redirects
# responde 200, Cloudflare SI lee este archivo; si responde 404, no lo lee.
/zzz-prueba-redirects   /index.html  200

# Rutas de la app con parametro (/pacientes/3451, /citas/99...): no existen como archivo, las
# resuelve el router de Angular sobre index.html.
# Cloudflare Pages solo admite el splat al FINAL de la ruta, por eso va una linea por modulo.
# Al agregar un modulo nuevo en app.routes.ts, agregar aqui su linea.
/dashboard/*            /index.html  200
/citas/*                /index.html  200
/pacientes/*            /index.html  200
/terapeutas/*           /index.html  200
/pagos/*                /index.html  200
/caja/*                 /index.html  200
/adelantos/*            /index.html  200
/productos/*            /index.html  200
/atenciones/*           /index.html  200
/tratamientos/*         /index.html  200
/configuraciones/*      /index.html  200
/seguridad/*            /index.html  200
/login/*                /index.html  200
/olvide-password/*      /index.html  200
/restablecer-password/* /index.html  200
/sin-acceso/*           /index.html  200
